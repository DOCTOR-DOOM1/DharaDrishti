# ──────────────────────────────────────────────
# DharaDrishti — Environment Configuration
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# ── Postgres (PostGIS) ──
POSTGRES_USER=dharadrishti
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dharadrishti
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── MinIO (S3-compatible) ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=dharadrishti
MINIO_USE_SSL=false
AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}

# ── TiTiler ──
TITILER_ENDPOINT=http://titiler:8001

# ── API ──
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
ADMIN_TOKEN=dev-admin-token-change-in-prod
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Worker ──
RQ_QUEUES=ingest,compute,reports
RQ_WORKER_COUNT=2

# ── Data paths ──
DATA_DIR=/data
FIXTURE_DIR=/data/fixture
PRODUCTS_DIR=/data/products
